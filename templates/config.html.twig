{% import 'components/form/fields_macros.html.twig' as fields %}

<div class="card">
    <div class="card-header">
        <h3 class="card-title mb-0">{{ __('InAppNotification settings', 'inappnotification') }}</h3>
    </div>
    <form method="post" action="{{ form_url }}" data-submit-once>
        <div class="card-body">
            {{ fields.smallTitle(__('Capture sources', 'inappnotification'), 'ti ti-filter', __('Choose which source families are persisted as in-app notifications.', 'inappnotification')) }}
            <div class="row">
                {% for name, label in source_fields %}
                    {{ fields.dropdownYesNo(name, settings[name], label) }}
                {% endfor %}
            </div>

            {{ fields.smallTitle(__('Ticket filter', 'inappnotification'), 'ti ti-ticket', __('Optional ticket-specific rule for captured ticket alerts.', 'inappnotification')) }}
            <div class="row">
                {{ fields.dropdownYesNo('ticket_open_only', settings['ticket_open_only'], __('Capture only open tickets', 'inappnotification')) }}
            </div>

            {{ fields.smallTitle(__('Itemtype filters', 'inappnotification'), 'ti ti-list-check', __('Optional CSV filters by GLPI class/itemtype names.', 'inappnotification')) }}
            <div class="row">
                {{ fields.textField('include_itemtypes', settings['include_itemtypes'], __('Include only itemtypes (CSV)', 'inappnotification'), {
                    additional_attributes: {placeholder: 'Ticket,Project,SavedSearch_Alert'},
                }) }}
                {{ fields.textField('exclude_itemtypes', settings['exclude_itemtypes'], __('Exclude itemtypes (CSV)', 'inappnotification'), {
                    additional_attributes: {placeholder: 'Change,Problem'},
                }) }}
            </div>
        </div>
        <div class="card-footer d-flex justify-content-end">
            <button type="submit" name="update" value="1" class="btn btn-primary">
                <i class="ti ti-device-floppy me-1" aria-hidden="true"></i>{{ _x('button', 'Save') }}
            </button>
        </div>
    </form>
</div>
