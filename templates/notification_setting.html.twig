{% if enabled %}
    <div class="card">
        <div class="card-body d-flex flex-column gap-3">
            <p class="mb-0">{{ __('InAppNotification is enabled. Use plugin settings to configure filters and sources.', 'inappnotification') }}</p>
            <form method="post" action="{{ form_url }}" class="d-flex flex-wrap gap-2" data-submit-once>
                <a class="btn btn-primary" href="{{ config_url }}">
                    <i class="ti ti-settings me-1" aria-hidden="true"></i>{{ __('Open InAppNotification settings', 'inappnotification') }}
                </a>
                <button type="submit" name="test_inapp_send" value="1" class="btn btn-outline-secondary">
                    <i class="ti ti-bell-ringing me-1" aria-hidden="true"></i>{{ __('Send a test in-app notification to you', 'inappnotification') }}
                </button>
            </form>
        </div>
    </div>
{% else %}
    <div class="alert alert-warning">
        <a href="{{ path('front/setup.notification.php') }}">{{ __('Notifications are disabled.') }}</a>
    </div>
{% endif %}
